#!name=去广告合集
#!desc=合并可莉 HTTPDNS拦截器、广告平台拦截器、可莉广告过滤器与 blackmatrix7 AdvertisingLite，每周自动从上游重新生成。需开启 MITM 并信任证书。
#!category=Block
# source: https://raw.githubusercontent.com/Repcz/Tool/X/Surge/Module/Kelee/Block_HTTPDNS.sgmodule (upstream date: 2026-10-02 13:57:49)
# source: https://raw.githubusercontent.com/Repcz/Tool/X/Surge/Module/Kelee/BlockAdvertisers.sgmodule (upstream date: 2026-10-02 13:57:49)
# source: https://raw.githubusercontent.com/Repcz/Tool/X/Surge/Module/Kelee/Remove_ads_by_keli.sgmodule (upstream date: 2026-10-02 13:57:49)

[Rule]
# ---- Block_HTTPDNS ----
DOMAIN-KEYWORD,httpdns,REJECT,pre-matching
DOMAIN-KEYWORD,httpsdns,REJECT,pre-matching
USER-AGENT,"httpdns*",REJECT
USER-AGENT,"httpsdns*",REJECT
USER-AGENT,"Httpdns*",REJECT
USER-AGENT,"Httpsdns*",REJECT
AND,((URL-REGEX, ^http:\/\/119\.29\.29\.90\/d\?), (USER-AGENT, %E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*)),DIRECT
AND,((URL-REGEX, ^http:\/\/119\.28\.28\.90\/d\?), (USER-AGENT, %E5%98%80%E5%97%92%E5%87%BA%E8%A1%8C*)),DIRECT
URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?",REJECT
URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\](?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?",REJECT
